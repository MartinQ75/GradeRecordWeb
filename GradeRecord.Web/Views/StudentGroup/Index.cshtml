@model IEnumerable<GradeRecord.Class.Models.Student_Group_Model>

@{
    ViewData["Title"] = "Inscripción de Alumnos a Grupos";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Inscripción de Alumnos a Grupos</h2>
        <a asp-action="Create" class="btn btn-success">+ Inscribir Alumno</a>
    </div>

    <table class="table table-striped table-hover shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Alumno</th>
                <th>Grupo</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @(item.Student != null
                                ? $"{item.Student.Enrollment} - {item.Student.StudentName} {item.Student.Paternal_Surname}"
                                : $"ID Alumno: {item.Id_Student}")
                        </td>
                        <td>
                            @(item.Group != null ? item.Group.Name_Group : $"ID Grupo: {item.Id_Group}")
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Editar</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Eliminar</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="3" class="text-center text-muted">No hay alumnos inscritos en ningún grupo.</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="mt-3">
        <a asp-controller="Admin" asp-action="Index" class="btn btn-secondary">Regresar al Dashboard</a>
    </div>
</div>
