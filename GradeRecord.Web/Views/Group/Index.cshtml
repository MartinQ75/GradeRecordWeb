@model IEnumerable<GradeRecord.Class.Models.GroupModel>

@{
    ViewData["Title"] = "Gestión de Grupos";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Catálogo de Grupos</h2>
        <a asp-action="Create" class="btn btn-success">+ Nuevo Grupo</a>
    </div>

    <table class="table table-striped table-hover shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Nombre del Grupo</th>
                <th>Semestre</th>
                <th>Periodo (Term)</th>
                <th>Turno</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Name_Group</td>
                        <td>@item.Semester</td>
                        <td>@item.Term</td>
                        <td>@item.Turn</td>
                        <td>
                            <span class="badge @(item.Status ? "bg-success" : "bg-danger")">
                                @(item.Status ? "Activo" : "Inactivo")
                            </span>
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Editar</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Eliminar</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center text-muted">No hay grupos registrados.</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="mt-3">
        <a asp-controller="Admin" asp-action="Index" class="btn btn-secondary">Regresar al Dashboard</a>
    </div>
</div>