@model IEnumerable<GradeRecord.Class.Models.Teacher_Subject_Group_Model>

@{
    ViewData["Title"] = "Asignación Docente - Materia";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Asignación de Docentes a Materias y Grupos</h2>
        <a asp-action="Create" class="btn btn-success">+ Nueva Asignación</a>
    </div>

    <table class="table table-striped table-hover shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Docente</th>
                <th>Materia</th>
                <th>Grupo</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @(item.Teacher != null ? $"{item.Teacher.Name} {item.Teacher.Paternal_Surname}" : $"ID: {item.Id_Teacher}")
                        </td>
                        <td>
                            @(item.Subject != null ? item.Subject.Name_Subject : $"ID: {item.Id_Subject}")
                        </td>
                        <td>
                            @(item.Group != null ? item.Group.Name_Group : $"ID: {item.Id_Group}")
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Editar</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Eliminar</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center text-muted">No hay asignaciones registradas.</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="mt-3">
        <a asp-controller="Admin" asp-action="Index" class="btn btn-secondary">Regresar al Dashboard</a>
    </div>
</div>