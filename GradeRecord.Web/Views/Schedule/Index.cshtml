@model IEnumerable<GradeRecord.Class.Models.ScheduleModel>

@{
    ViewData["Title"] = "Gestión de Horarios";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Horarios Asignados</h2>
        <a asp-action="Create" class="btn btn-success">+ Asignar Horario</a>
    </div>

    <table class="table table-striped table-hover shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>ID Asignación</th>
                <th>Día</th>
                <th>Hora Inicio</th>
                <th>Hora Fin</th>
                <th>Aula / Salón</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id_Teacher_Subject</td>
                        <td>@item.DayOfWeek</td>
                        <td>@item.StartTime.ToString(@"hh\:mm") hrs</td>
                        <td>@item.EndTime.ToString(@"hh\:mm") hrs</td>
                        <td>@item.Classroom</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Editar</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Eliminar</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center text-muted">No hay horarios registrados.</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="mt-3">
        <a asp-controller="Admin" asp-action="Index" class="btn btn-secondary">Regresar al Dashboard</a>
    </div>
</div>