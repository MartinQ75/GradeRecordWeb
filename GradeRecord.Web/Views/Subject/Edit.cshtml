@model GradeRecord.Class.Models.SubjectModel

@{
    ViewData["Title"] = "Editar Materia";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Editar Materia</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Code_Subject" class="form-label">Código de Materia</label>
                                <input asp-for="Code_Subject" class="form-control" required />
                                <span asp-validation-for="Code_Subject" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Name_Subject" class="form-label">Nombre de Materia</label>
                                <input asp-for="Name_Subject" class="form-control" required />
                                <span asp-validation-for="Name_Subject" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="Credits" class="form-label">Créditos</label>
                                <input asp-for="Credits" type="number" class="form-control" min="1" required />
                                <span asp-validation-for="Credits" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="Semester" class="form-label">Semestre</label>
                                <input asp-for="Semester" type="number" class="form-control" min="1" max="12" required />
                                <span asp-validation-for="Semester" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="Units" class="form-label">Unidades Evaluables</label>
                                <input asp-for="Units" type="number" class="form-control" min="1" max="10" required />
                                <span asp-validation-for="Units" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="form-check mb-4">
                            <input class="form-check-input" type="checkbox" asp-for="Status" />
                            <label class="form-check-label" asp-for="Status">
                                Activa
                            </label>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-primary">Actualizar Cambios</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
