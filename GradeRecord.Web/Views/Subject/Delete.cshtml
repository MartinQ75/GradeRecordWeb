@model GradeRecord.Class.Models.SubjectModel

@{
    ViewData["Title"] = "Eliminar Materia";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-danger shadow-sm">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">Confirmar Eliminación</h4>
                </div>
                <div class="card-body">
                    <p class="text-muted mb-4">¿Estás seguro de que deseas eliminar la siguiente materia del sistema?</p>

                    <dl class="row">
                        <dt class="col-sm-4">Código:</dt>
                        <dd class="col-sm-8">@Model.Code_Subject</dd>

                        <dt class="col-sm-4">Nombre:</dt>
                        <dd class="col-sm-8">@Model.Name_Subject</dd>

                        <dt class="col-sm-4">Créditos:</dt>
                        <dd class="col-sm-8">@Model.Credits</dd>

                        <dt class="col-sm-4">Semestre:</dt>
                        <dd class="col-sm-8">@Model.Semester</dd>

                        <dt class="col-sm-4">Estado:</dt>
                        <dd class="col-sm-8">
                            <span class="badge @(Model.Status ? "bg-success" : "bg-danger")">
                                @(Model.Status ? "Activa" : "Inactiva")
                            </span>
                        </dd>
                    </dl>

                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-danger">Confirmar Eliminación</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>